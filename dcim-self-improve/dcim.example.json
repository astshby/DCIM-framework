{
  "schema_version": 1,
  "node": "user-declared-target-profile",
  "work_root": "./runs",
  "resources": {
    "circuit": {
      "path": "./private/independent-source.cdl",
      "kind": "file",
      "role": "independent circuit intent"
    },
    "process": {
      "path": "./private/process",
      "kind": "directory",
